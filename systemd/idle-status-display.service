[Unit]
Description=Idle status screen: kmscon on the status VT (read-only view)
Documentation=file:///usr/share/doc/idle-status-screen/README.md
After=systemd-user-sessions.service systemd-logind.service idle-status-monitor.service
Wants=idle-status-monitor.service

[Service]
Type=simple
ExecStart=/usr/libexec/idle-status/display
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
